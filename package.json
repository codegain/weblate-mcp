{
  "name": "@mmntm/weblate-mcp",
  "version": "1.3.1",
  "description": "A Model Context Protocol (MCP) server for Weblate translation management",
  "author": "Your Name",
  "license": "MIT",
  "main": "dist/main.js",
  "bin": {
    "weblate-mcp": "dist/main.js"
  },
  "files": [
    "dist/**/*",
    "docs/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nest build && npm run postbuild",
    "postbuild": "shx chmod +x dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@rekog/mcp-nest": "^1.9.2",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {},
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "keywords": [
    "weblate",
    "mcp",
    "model-context-protocol",
    "translation",
    "localization",
    "nestjs",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmntm/weblate-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mmntm/weblate-mcp/issues"
  },
  "homepage": "https://github.com/mmntm/weblate-mcp#readme"
}
